<Window x:Class="PrismWinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prism / 棱镜">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefault}">
            <StackPanel>
                <Button Content="+ 新对话" Click="NewConversation_Click" Margin="12" Style="{StaticResource AccentButtonStyle}"/>
                <ListBox x:Name="ConversationList" SelectionChanged="Conversation_Selected" Margin="12,0"/>
            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MessageScroll" Grid.Row="0">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" Margin="12,4" CornerRadius="12"
                                    Background="{Binding IsUser, Converter={StaticResource BubbleColorConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="1" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="输入消息..." KeyDown="InputBox_KeyDown"/>
                    <Button x:Name="SendBtn" Grid.Column="1" Content="↑" Click="Send_Click" Width="40" Height="40" CornerRadius="20" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
